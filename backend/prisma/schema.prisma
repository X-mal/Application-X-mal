generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model arquivos {
  id        Int                 @id @default(autoincrement())
  descricao String              @db.VarChar(255)
  estado    estado_arquivo_enum @default(enviado)
  iduser    Int
  user      user                @relation(fields: [iduser], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_user")
  resp      resp[]
}

model resp {
  id       Int      @id @default(autoincrement())
  resposta String   @db.VarChar(255)
  arquivo  Int
  adm      Int
  useradm  useradm  @relation(fields: [adm], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_adm_resp")
  arquivos arquivos @relation(fields: [arquivo], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_arquivos_resp")
}

model useradm {
  id       Int         @id @default(autoincrement())
  username String      @db.VarChar(250)
  email    String      @db.VarChar(250)
  pass     String      @db.VarChar(250)
  setor    setor_enum @default(tecnico)
  resp     resp[]
  estado   estado_adm_enum @default(ativo)

}

model user {
  id       Int           @id @default(autoincrement())
  ra       String        @unique @db.VarChar(255)
  username String        @db.VarChar(250)
  email    String        @db.VarChar(250)
  pass     String        @db.VarChar(250)
  curso    String        @db.VarChar(255)
  instituto instituto_enum 
  turno    turno_enum
  situacao situacao_enum @default(cursando)
  arquivos arquivos[]
}

enum estado_arquivo_enum {
  enviado
  recebido
  negado
  aprovado
}

enum setor_enum {
  faculdade
  tecnico
}

enum situacao_enum {
  cursando
  trancado
  finalizado
}

enum instituto_enum {
  tecnico
  faculdade
}

enum turno_enum {
  matutino
  noturno
}
enum estado_adm_enum {
  ativo
  inativo
}